{
  "name": "windchill-smartguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/demo-portal/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config apps/demo-portal/vite.config.ts && node scripts/build-extension.mjs",
    "build:portal": "vite build --config apps/demo-portal/vite.config.ts",
    "build:extension": "npm run typecheck && node scripts/build-extension.mjs",
    "build:extension:production": "npm run typecheck && node scripts/build-extension.mjs --mode production",
    "build:production": "node scripts/build-production.mjs",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.30",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
