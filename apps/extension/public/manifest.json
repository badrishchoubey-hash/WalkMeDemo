{
  "manifest_version": 3,
  "name": "Windchill Extension Demo",
  "version": "0.1.0",
  "description": "On-page walkthroughs and contextual tips for a simulated PLM portal. Independent demo; not an official PTC product.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/demo-16.png",
    "32": "icons/demo-32.png",
    "48": "icons/demo-48.png",
    "128": "icons/demo-128.png"
  },
  "action": {
    "default_title": "Open User / Developer mode",
    "default_icon": { "16": "icons/demo-16.png", "32": "icons/demo-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "admin.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
